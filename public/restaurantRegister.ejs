<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Registo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container">
            <div class="collapse navbar-collapse">
                <a href="index.html" class="navbar-btn btn-outline-primary me-2">Home</a>
            </div>
        </div>
    </nav>
    
    <section class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">Registo do restaurante</div>
                    <div class="card-body">
                        <form method="POST" action="/auth/registerRestaurant">
                            <input type="hidden" name="userType" value="restaurant">
                            <div class="mb-3">
                                <label class="form-label">Nome</label>
                                <input name="name" type="text" class="form-control" minlength="5" maxlength="50" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Logotipo</label>
                                <input name="logo" type="file" accept="image/*" class="form-control">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Morada</label>
                                <input name="address" type="text" class="form-control" minlength="5" maxlength="100" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Telefone</label>
                                <input name="phone" type="text" class="form-control" minlength="9" maxlength="9" required>
                            </div>
                            <div class = "mb-3">
                                <label class="form-label">Número de Identificação Fiscal (NIF)</label>
                                <input name="nif" type="text" class="form-control" minlength="9" maxlength="9" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Username</label>
                                <input name="username" type="text" class="form-control" minlength="5" maxlength="20" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Email</label>
                                <input name="email" type="email" class="form-control" minlength="5" maxlength="50" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Password</label>
                                <input name="password" type="password" class="form-control" minlength="8" maxlength="20" required>
                            </div>
                            <button type="submit" class="btn btn-success w-100">Registar</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>