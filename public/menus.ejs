<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Gestão de Menus</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-5">
        <h2>Criar Menus</h2>
        <form id="menuForm">
            <input type="text" id="menuName" class="form-control mb-2" placeholder="Nome do Menu" required>
            <button type="submit" class="btn btn-success">Criar Menu</button>
        </form>
        
        <h3 class="mt-4">Menus Criados</h3>
        <div id="menuList"></div>
    </div>

    <script>
        document.getElementById('menuForm').addEventListener('submit', async function(event) {
            event.preventDefault();
            const menuName = document.getElementById('menuName').value;
            const token = localStorage.getItem('token');

            if (!token) {
                alert("Erro: Token não encontrado. Por favor, faça login novamente.");
                return;
            }

            try {
                const response = await fetch('/menu/create', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({ name: menuName, categories: [] })
                });

                const result = await response.json();
                if (response.ok) {
                    alert("Menu criado com sucesso!");
                    loadMenus();
                } else {
                    alert(`${result.message}`);
                    console.error("Erro:", result);
                }
            } catch (error) {
                alert("Erro ao conectar ao servidor.");
                console.error("Erro:", error);
            }
        });

        async function loadMenus() {
            const token = localStorage.getItem('token');
            const response = await fetch('/menu/list', {
                method: 'GET',
                headers: {
                    'Authorization': `Bearer ${token}`
                }
            });
            const menus = await response.json();
            let html = '';

            menus.forEach(menu => {
                html += `<div class="card mt-2 p-3">
                            <h5>${menu.name}</h5>
                            <p>Pratos:</p>
                            <ul>`;
                
                menu.dishes.forEach(dish => {
                    html += `<li>${dish.name} - ${dish.price}€</li>`;
                });

                html += `</ul>
                        </div>`;
            });

            document.getElementById('menuList').innerHTML = html;
        }

        loadMenus();
    </script>    
</body>
</html>