# Variáveis usadas pelo docker-compose.yml (copie para ".env" nesta pasta).
# Utilizador administrador do MongoDB local
MONGO_ROOT_USERNAME=snackify
# Use uma password longa e aleatória (ex.: openssl rand -base64 24)
MONGO_ROOT_PASSWORD=

# --- Cópias de segurança (scripts/backup.sh e scripts/restore.sh) -----------
# Pasta e número de cópias a manter
BACKUP_DIR=./backups
BACKUP_KEEP=7
# Cifrar as cópias (recomendado se saírem desta máquina): chave pública age (age1...)
# ou, em alternativa, um destinatário GPG. Para repor uma cópia .age: BACKUP_AGE_IDENTITY=<ficheiro da chave privada>
BACKUP_AGE_RECIPIENT=
BACKUP_GPG_RECIPIENT=
