<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Checkout - Confirmação da Encomenda</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <%- include('../partials/navbar') %>
  
  <div class="container">
    <h2>Encomenda registada</h2>
    <p>O seu código de encomenda é: <strong><%= order.orderCode %></strong></p>
    <ul>
      <% order.dishes.forEach(item => { %>
        <li>
          <%= item.dishId.name %> - <%= item.dose %> dose - Quantidade: <%= item.amount %>
        </li>
      <% }) %>
    </ul>
    <p>Estado: <%= order.state %></p>
  </div>
</body>
</html>