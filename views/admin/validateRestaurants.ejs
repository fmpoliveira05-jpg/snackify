<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Validar Restaurantes</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/styles.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    
    <div class="container mt-5">
        <h1>Restaurantes por validar</h1>
        <ul class="list-group mt-4">
            <% if (restaurantes.length === 0) { %>
                <li class="list-group-item">Nenhum restaurante por validar.</li>
            <% } %>
            <% restaurantes.forEach(r => { %>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <strong><%= r.name %></strong> - <%= r.email %>
                    </div>
                    <form action="/admin/validar-restaurante/<%= r._id %>" method="POST">
                        <button class="btn btn-success btn-sm">Validar</button>
                    </form>
                </li>
            <% }); %>
        </ul>
    </div>
</body>
</html>