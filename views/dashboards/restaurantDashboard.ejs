<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Painel do Restaurante</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/styles.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    
    <div class="container mt-5">
        <h4>Aqui poderá gerir os seus produtos, encomendas e informações.</h4>
        <div id="ordersStateChart" class="my-4"></div>
        <div id="orderStatsData" data-chart='<%- JSON.stringify(orderStats || []) %>'></div>
    
        <a href="/restaurante/pratos/novo" class="btn btn-warning mb-2 btn-largo">Criar novo prato</a><br>
        <a href="/restaurante/menus/novo" class="btn btn-success mb-2 btn-largo">Criar novo menu</a><br>
        <a href="/restaurante/pratos" class="btn btn-outline-secondary mb-2 btn-largo">Ver pratos criados</a><br>
        <a href="/restaurante/menus" class="btn btn-outline-primary mb-2 btn-largo">Ver menus disponíveis</a>
    </div>

    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
    <script type="text/javascript" src="/javascripts/drawCharts.js"></script>   
</body>
</html>