<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Painel do Restaurante</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/styles.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    
    <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
        <ul class="navbar-nav">
            <% if (user) { %>
            <li class="nav-item">
                <a class="btn btn-outline-secondary ms-2" href="/user/perfil">Perfil</a>
            </li>
            <button id="logoutBtn" class="btn btn-outline-danger ms-2">Sair</button>
            <% } else { %>
            <li class="nav-item">
                <a class="btn btn-outline-primary ms-2" href="/auth/login">Entrar</a>
            </li>
            <% } %>
        </ul>
    </div>
    
    <div class="container mt-5">
        <h2>Este é o Painel do Restaurante!</h2>
        <p class="lead">Aqui poderá gerir os seus produtos, encomendas e informações.</p>
    
        <a href="/pratos/novo" class="btn btn-warning mb-2 btn-largo">Criar novo prato</a><br>
        <a href="/menus/novo" class="btn btn-success mb-2 btn-largo">Criar novo menu</a><br>
        <a href="/pratos" class="btn btn-outline-secondary mb-2 btn-largo">Ver pratos criados</a><br>
        <a href="/menus" class="btn btn-outline-primary mb-2 btn-largo">Ver menus disponíveis</a>
    </div>    
</body>
</html>