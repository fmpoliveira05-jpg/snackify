<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/styles.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    
    <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
        <ul class="navbar-nav">
            <% if (user) { %>
            <li class="nav-item">
                <a class="btn btn-outline-secondary ms-2" href="/user/perfil">Perfil</a>
            </li>
            <button id="logoutBtn" class="btn btn-outline-danger ms-2">Sair</button>
            <% } else { %>
            <li class="nav-item">
                <a class="btn btn-outline-primary ms-2" href="/auth/login">Entrar</a>
            </li>
            <% } %>
        </ul>
    </div>
    
    <%- include('../partials/sidebar') %>
    <div class="container mt-5">
        <h4>Esta é a sua área pessoal.</h4>
        <button class="btn btn-primary" onclick="window.location.href='/clientes/restaurantes'">Ver restaurantes</button>
    </div>
</body>
</html>