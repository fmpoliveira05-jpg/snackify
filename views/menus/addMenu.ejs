<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Adicionar Menu</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-5">
        <h2>Adicionar novo menu</h2>

        <form action="/menus/novo" method="POST" enctype="multipart/form-data">
            <input name="title" class="form-control mb-2" placeholder="Título do menu" required />
            <textarea name="description" class="form-control mb-3" placeholder="Descrição do menu"></textarea>

            <h5>Adicionar pratos ao menu</h5>

            <div id="dishes-container">
                <div class="dish-entry border rounded p-3 mb-3">
                    <input name="dishes[0][name]" class="form-control mb-2" placeholder="Nome do prato" required />
                    <textarea name="dishes[0][description]" class="form-control mb-2" placeholder="Descrição (opcional)"></textarea>
                    <select name="dishes[0][category]" class="form-control mb-2" required>
                    <option value="">Seleciona a categoria</option>
                    <option value="Carne">Carne</option>
                    <option value="Peixe">Peixe</option>
                    <option value="Vegetariano">Vegetariano</option>
                    <option value="Sobremesa">Sobremesa</option>
                    </select>
                    <input name="dishes[0][price]" type="number" step="0.01" class="form-control mb-2" placeholder="Preço" required />
                    <input name="dishes[0][image]" type="file" class="form-control mb-2" accept="image/*" />
                    <input name="dishes[0][nutriInfo]" class="form-control mb-2" placeholder="Informação nutricional" required />
                </div>
            </div>
            <button type="button" id="add-dish" class="btn btn-outline-secondary mb-2 d-block w-25">Adicionar mais um prato</button>
            <button type="submit" class="btn btn-success d-block w-25">Criar menu</button>
        </form>
    </div>

    <script>
        let dishIndex = 1;
      
        document.getElementById('add-dish').addEventListener('click', () => {
          if (dishIndex >= 10) {
            alert('Máximo de 10 pratos por menu.');
            return;
          }
      
          const container = document.getElementById('dishes-container');
          const newDish = document.createElement('div');
          newDish.classList.add('dish-entry', 'border', 'rounded', 'p-3', 'mb-3');
      
          newDish.innerHTML = `
            <input name="dishes[${dishIndex}][name]" class="form-control mb-2" placeholder="Nome do prato" required />
            <textarea name="dishes[${dishIndex}][description]" class="form-control mb-2" placeholder="Descrição (opcional)"></textarea>
            <select name="dishes[${dishIndex}][category]" class="form-control mb-2" required>
              <option value="">Seleciona a categoria</option>
              <option value="Carne">Carne</option>
              <option value="Peixe">Peixe</option>
              <option value="Vegetariano">Vegetariano</option>
              <option value="Sobremesa">Sobremesa</option>
            </select>
            <input name="dishes[${dishIndex}][price]" type="number" step="0.01" class="form-control mb-2" placeholder="Preço" required />
            <input name="dishes[${dishIndex}][image]" type="file" class="form-control mb-2" accept="image/*" />
            <input name="dishes[${dishIndex}][nutriInfo]" class="form-control mb-2" placeholder="Informação nutricional" required />
          `;
      
          container.appendChild(newDish);
          dishIndex++;
        });
      </script>      
</body>
</html>