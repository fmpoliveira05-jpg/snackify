<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <title>Listagem de Menus</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <div class="container mt-5">
    <h2>Menus Disponíveis</h2>

    <% if (menus.length === 0) { %>
      <p>Nenhum menu encontrado.</p>
    <% } else { %>
      <% menus.forEach(menu => { %>
        <div class="card mb-4">
          <div class="card-body">
            <h4 class="card-title"><%= menu.title %></h4>
            <p class="card-text"><%= menu.description %></p>

            <% if (menu.dishes.length === 0) { %>
              <p class="text-muted">Este menu ainda não tem pratos.</p>
            <% } else { %>
              <ul class="list-group">
                <% menu.dishes.forEach(dish => { %>
                  <li class="list-group-item">
                    <div class="row align-items-center">
                      <div class="col-md-3">
                        <% if (dish.image) { %>
                          <img src="<%= '/uploads/' + dish.image %>" alt="<%= dish.name %>" class="img-fluid rounded" style="max-height: 120px;">
                        <% } %>
                      </div>
                      <div class="col-md-9">
                        <h5><%= dish.name %></h5>
                        <p class="mb-1"><strong>Categoria:</strong> <%= dish.category %> | <strong>Preço:</strong> €<%= dish.price.toFixed(2) %></p>
                        <% if (dish.description) { %>
                          <p class="mb-1"><%= dish.description %></p>
                        <% } %>
                        <% if (dish.nutriInfo) { %>
                          <small class="text-muted">Informação nutricional: <%= dish.nutriInfo %> kcal</small>
                        <% } %>
                      </div>
                    </div>
                  </li>
                <% }) %>
              </ul>
            <% } %>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</body>
</html>