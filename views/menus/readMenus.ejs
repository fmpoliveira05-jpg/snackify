<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <title>Listagem de Menus</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/styles.css">
</head>
<body>
  <%- include('../partials/navbar') %>
  <div class="container mt-5">
    <h2>Menus disponíveis</h2>

    <% if (menus.length === 0) { %>
      <p>Nenhum menu encontrado.</p>
    <% } else { %>
      <% menus.forEach(menu => { %>
        <div class="card mb-4">
          <div class="card-body">
            <h4 class="card-title"><%= menu.title %></h4>
            <p class="mb-0" class="card-text"><%= menu.description %></p>

            <div class="d-flex justify-content-end gap-2 mb-2">
              <a href="/menus/editar/<%= menu._id %>" class="btn btn-warning btn-sm">Editar menu</a>
              <form action="/menus/remover/<%= menu._id %>" method="POST" class="d-inline">
                <button class="btn btn-danger btn-sm" onclick="return confirm('Remover este menu?')">Remover <map name=""></map>menu</button>
              </form>
            </div>            

            <% if (menu.dishes.length === 0) { %>
              <p class="text-muted">Este menu ainda não tem pratos.</p>
            <% } else { %>
              <ul class="list-group">
                <% menu.dishes.forEach(dish => { %>
                  <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span><%= dish.name %></span>
                    <div class="d-flex gap-2">
                      <a href="/pratos/<%= dish._id %>" target="_blank" class="btn btn-primary btn-sm">Ver detalhes</a>
                      <form action="/menus/pratos/remover/<%= dish._id %>" method="POST" class="d-inline">
                        <button class="btn btn-outline-secondary btn-sm" onclick="return confirm('Remover este prato do menu?')">Remover do menu</button>
                      </form>
                    </div>
                  </li>                  
                <% }) %>
              </ul>
            <% } %>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</body>
</html>