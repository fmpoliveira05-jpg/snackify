<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <title>Criar Menu</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/styles.css">
</head>
<body>
  <%- include('../partials/navbar') %>
  
  <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
    <ul class="navbar-nav">
      <% if (user) { %>
        <li class="nav-item">
          <a class="btn btn-outline-secondary ms-2" href="/user/perfil">Perfil</a>
        </li>
        <button id="logoutBtn" class="btn btn-outline-danger ms-2">Sair</button>
      <% } else { %>
        <li class="nav-item">
          <a class="btn btn-outline-primary ms-2" href="/auth/login">Entrar</a>
        </li>
      <% } %>
    </ul>
  </div>
  
  <div class="container mt-5">
    <h2>Criar novo menu</h2>
    
    <% if (errors && errors.length > 0) { %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% errors.forEach(error => { %>
            <li><%= error.msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <form action="/menus/novo" method="POST">
      <input 
        name="title" 
        class="form-control mb-2" 
        placeholder="Título do menu" 
        required 
        value="<%= oldInput?.title || '' %>"
      />
      
      <textarea 
        name="description" 
        class="form-control mb-3" 
        placeholder="Descrição do menu (opcional)"
      ><%= oldInput?.description || '' %></textarea>

      <h4>Adicionar pratos</h4>
      <div class="row" id="dishes-grid">
        <% if (availableDishes.length === 0) { %>
          <p class="text-muted text-start">Não há pratos disponíveis no momento.</p>
        <% } else { %>
          <% availableDishes.forEach((dish, index) => { %>
            <div class="col-md-4 mb-3">
              <div class="card dish-card" data-dish-id="<%= dish._id %>">
                <% if (dish.imagePath && dish.image) { %>
                  <img src="/uploads/<%= dish.image %>" class="card-img-top" alt="<%= dish.name %>">
                <% } %>
                <div class="card-body">
                  <h5 class="card-title"><%= dish.name %></h5>
                  <p class="card-text"><%= dish.description || '' %></p>
                  <p><strong>Categoria:</strong> <%= dish.category %></p>
                  <% if (dish.pricePerDose && dish.pricePerDose.length) { %>
                    <p><strong>Preços por tipo de dose:</strong>
                      <% dish.pricePerDose.forEach(p => { %>
                        <br> <%= p.dose %> dose: €<%= p.price.toFixed(2) %>
                      <% }) %>
                    </p>
                  <% } else { %>
                    <p><strong>Preço:</strong> Não disponível</p>
                  <% } %>
                  <p><strong>Informação nutricional:</strong> <%= dish.nutriInfo.calories %> kcal</p>
                </div>
                <input 
                  type="checkbox" 
                  name="selectedDishes" 
                  value="<%= dish._id %>" 
                  class="d-none dish-checkbox"
                  <%= oldInput?.selectedDishes?.includes(dish._id.toString()) ? 'checked' : '' %>
                />
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>

      <button type="submit" class="btn btn-success mt-3">Criar menu</button>
    </form>
  </div>

  <script src="/javascripts/selectDishes.js"></script>
</body>
</html>