<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <title>Criar Menu</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    .dish-card {
      cursor: pointer;
      transition: transform 0.2s;
    }

    .dish-card:hover {
      transform: scale(1.02);
    }

    .dish-card.selected {
      border: 2px solid green;
      background-color: #e6ffe6;
    }
  </style>
</head>
<body>
  <div class="container mt-5">
    <h2>Criar novo menu</h2>
    <form action="/menus/novo" method="POST">
      <input name="title" class="form-control mb-2" placeholder="Título do menu" required />
      <textarea name="description" class="form-control mb-3" placeholder="Descrição do menu (opcional)"></textarea>

      <h4>Adicionar pratos</h4>
      <div class="row" id="dishes-grid">
        <% if (availableDishes.length === 0) { %>
          <p class="text-muted text-center">Não há pratos disponíveis no momento.</p>
        <% } else { %>
          <% availableDishes.forEach((dish, index) => { %>
            <div class="col-md-4 mb-3">
              <div class="card dish-card" data-dish-id="<%= dish._id %>">
                <% if (dish.imagePath && dish.image) { %>
                  <img src="/uploads/<%= dish.image %>" class="card-img-top" alt="<%= dish.name %>">
                <% } %>
                <div class="card-body">
                  <h5 class="card-title"><%= dish.name %></h5>
                  <p class="card-text"><%= dish.description || '' %></p>
                  <p><strong>Categoria:</strong> <%= dish.category %></p>
                  <p><strong>Preço:</strong> €<%= dish.price.toFixed(2) %></p>
                  <p><strong>Informação nutricional:</strong> <%= dish.nutriInfo %> kcal</p>
                </div>
                <input type="checkbox" name="selectedDishes" value="<%= dish._id %>" class="d-none dish-checkbox" />
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>      

      <button type="submit" class="btn btn-success mt-3">Criar menu</button>
    </form>
  </div>

  <script>
    const selected = new Set();
    const maxDishes = 10;

    document.querySelectorAll('.dish-card').forEach(card => {
      card.addEventListener('click', () => {
        const checkbox = card.querySelector('.dish-checkbox');
        const dishId = card.dataset.dishId;

        if (!checkbox.checked && selected.size >= maxDishes) {
          alert("Máximo de 10 pratos por menu.");
          return;
        }

        checkbox.checked = !checkbox.checked;
        card.classList.toggle('selected', checkbox.checked);

        if (checkbox.checked) {
          selected.add(dishId);
        } else {
          selected.delete(dishId);
        }
      });
    });
  </script>
</body>
</html>