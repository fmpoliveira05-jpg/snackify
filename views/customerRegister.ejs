<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Registo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container">
            <div class="collapse navbar-collapse">
                <a href="/" class="navbar-btn btn-outline-primary me-2">Home</a>
            </div>
        </div>
    </nav>
    
    <section class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">Registo do cliente</div>
                    <div class="card-body">
                        <form method="POST" action="/auth/register/customer" enctype="multipart/form-data">
                            <input type="hidden" name="userType" value="customer">
                            <div class="mb-3">
                                <label class="form-label">Nome</label>
                                <input name="name" type="text" placeholder="Introduza o seu nome completo" class="form-control" maxlength="50" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Foto de perfil (opcional)</label>
                                <input name="profilePicture" type="file" accept="image/*" class="form-control">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Data de nascimento</label>
                                <input name="birthDate" type="date" class="form-control" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Morada</label>
                                <input name="address" type="text" placeholder="Introduza a sua morada" class="form-control" maxlength="100" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Telemóvel</label>
                                <input name="phone" type="text" placeholder="Introduza o seu número de telemóvel" class="form-control" minlength="9" maxlength="9" required>
                            </div>
                            <div class = "mb-3">
                                <label class="form-label">NIF</label>
                                <input name="nif" type="text" placeholder="Introduza o seu número de contribuinte (opcional)" class="form-control" minlength="9" maxlength="9">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Username</label>
                                <input name="username" type="text" placeholder="Introduza o seu nome de utilizador" class="form-control" maxlength="20" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Email</label>
                                <input name="email" type="email" placeholder="Introduza o seu email" class="form-control" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Password</label>
                                <input name="password" type="password" placeholder="Introduza a sua palavra-passe" class="form-control" minlength="8" maxlength="20" required>
                            </div>
                            <button type="submit" class="btn btn-success w-100">Registar</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>