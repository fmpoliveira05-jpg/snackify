<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <title>Adicionar Prato</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/styles.css">
</head>
<body>
  <%- include('../partials/navbar') %>
  <div class="container mt-5">
    <h2>Criar novo prato</h2>

    <% if (errors && errors.length > 0) { %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% errors.forEach(error => { %>
            <li><%= error.msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <form action="/pratos/novo" method="POST" enctype="multipart/form-data">
      <input 
        name="name" 
        class="form-control mb-2" 
        placeholder="Nome do prato" 
        required 
        value="<%= oldInput?.name || '' %>" 
      />

      <textarea 
        name="description" 
        class="form-control mb-2" 
        placeholder="Descrição (opcional)"
      ><%= oldInput?.description || '' %></textarea>

      <select name="category" class="form-control mb-2" required>
        <option value="">Seleciona a categoria</option>
        <option value="Carne" <%= oldInput?.category === 'Carne' ? 'selected' : '' %>>Carne</option>
        <option value="Peixe" <%= oldInput?.category === 'Peixe' ? 'selected' : '' %>>Peixe</option>
        <option value="Vegetariano" <%= oldInput?.category === 'Vegetariano' ? 'selected' : '' %>>Vegetariano</option>
        <option value="Sobremesa" <%= oldInput?.category === 'Sobremesa' ? 'selected' : '' %>>Sobremesa</option>
      </select>

      <div class="input-group mb-2">
        <span class="input-group-text">1/2 Dose</span>
        <input type="hidden" name="dose[]" value="1/2" />
        <input 
          name="price[]" 
          type="number" 
          step="0.01" 
          class="form-control" 
          placeholder="Preço (€)"  
          value="<%= oldInput?.price?.[0] || '' %>" 
        />
      </div>
      
      <div class="input-group mb-2">
        <span class="input-group-text">1 Dose</span>
        <input type="hidden" name="dose[]" value="1" />
        <input 
          name="price[]" 
          type="number" 
          step="0.01" 
          class="form-control" 
          placeholder="Preço (€)" 
          value="<%= oldInput?.price?.[1] || '' %>" 
        />
      </div>

      <input 
        name="image" 
        type="file" 
        class="form-control mb-2" 
        accept="image/*" 
      />

      <button type="submit" class="btn btn-success">Criar prato</button>
    </form>         
  </div>
</body>
</html>