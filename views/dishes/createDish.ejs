<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <title>Adicionar Prato</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/styles.css">
</head>
<body>
  <%- include('../partials/navbar') %>
  <div class="container mt-5">
    <h2>Criar novo prato</h2>
    <form action="/pratos/novo" method="POST" enctype="multipart/form-data">
      <input name="name" class="form-control mb-2" placeholder="Nome do prato" required />
      <textarea name="description" class="form-control mb-2" placeholder="Descrição (opcional)"></textarea>
      <select name="category" class="form-control mb-2" required>
        <option value="">Seleciona a categoria</option>
        <option value="Carne">Carne</option>
        <option value="Peixe">Peixe</option>
        <option value="Vegetariano">Vegetariano</option>
        <option value="Sobremesa">Sobremesa</option>
      </select>
      <input name="price" type="number" step="0.01" class="form-control mb-2" placeholder="Preço (€)" required />
      <input name="image" type="file" class="form-control mb-2" accept="image/*" />
      <input name="nutriInfo" class="form-control mb-3" placeholder="Informação nutricional" required />

      <button type="submit" class="btn btn-success">Criar prato</button>
    </form>
  </div>
</body>
</html>