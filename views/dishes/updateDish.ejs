<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <title>Editar Prato</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/styles.css">
</head>
<body>
  <%- include('../partials/navbar') %>
  <div class="container mt-5">
    <h2>Editar Prato</h2>

    <% if (errors && errors.length > 0) { %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% errors.forEach(error => { %>
            <li><%= error.msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <form action="/pratos/editar/<%= dish._id %>" method="POST" enctype="multipart/form-data">
      <div class="mb-3">
        <label class="form-label">Nome</label>
        <input 
          type="text" 
          name="name" 
          class="form-control" 
          required 
          value="<%= oldInput?.name || dish.name %>" 
        >
      </div>

      <div class="mb-3">
        <label class="form-label">Descrição</label>
        <textarea 
          name="description" 
          class="form-control"
        ><%= oldInput?.description || dish.description %></textarea>
      </div>

      <div class="mb-3">
        <label class="form-label">Categoria</label>
        <select name="category" class="form-control" required>
          <% ['Carne', 'Peixe', 'Vegetariano', 'Sobremesa'].forEach(cat => { %>
            <option value="<%= cat %>" <%= (oldInput?.category || dish.category) === cat ? 'selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>
      </div>

      <div class="mb-3">
        <label class="form-label">Preço por Dose</label>

        <% 
          const doseMap = { '1/2': '', '1': '' };
          if (Array.isArray(dish.pricePerDose)) {
            dish.pricePerDose.forEach(p => { doseMap[p.dose] = p.price });
          }
        %>

        <div class="mb-2">
          <label class="form-label">1/2 Dose</label>
          <input type="hidden" name="dose" value="1/2" />
          <input 
            type="number" 
            step="0.01" 
            name="price" 
            class="form-control" 
            value="<%= oldInput?.dose === '1/2' ? oldInput?.price : doseMap['1/2'] %>" 
          />
        </div>

        <div>
          <label class="form-label">1 Dose</label>
          <input type="hidden" name="dose" value="1" />
          <input 
            type="number" 
            step="0.01" 
            name="price" 
            class="form-control" 
            value="<%= oldInput?.dose === '1' ? oldInput?.price : doseMap['1'] %>" 
          />
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label">Imagem (opcional)</label>
        <input type="file" name="image" class="form-control">
      </div>

      <button type="submit" class="btn btn-primary">Guardar Alterações</button>
      <a href="/pratos" class="btn btn-secondary ms-2">Cancelar</a>
    </form>
  </div>
</body>
</html>