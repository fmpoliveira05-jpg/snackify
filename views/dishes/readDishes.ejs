<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <title>Pratos Criados</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/styles.css">
</head>
<body>
  <%- include('../partials/navbar') %>
  <div class="container mt-5">
    <h2>Pratos criados</h2>

    <% if (dishes.length === 0) { %>
      <p>Nenhum prato encontrado.</p>
    <% } else { %>
      <div class="row">
        <% dishes.forEach(dish => { %>
          <div class="col-md-4 mb-4">
            <div class="card h-100">
              <% if (dish.image) { %>
                <img src="<%= dish.image %>" class="card-img-top" alt="<%= dish.name %>">
              <% } else { %>
                <img src="/images/sem-imagem.png" class="card-img-top" alt="Sem imagem">
              <% } %>
              <div class="card-body d-flex flex-column">
                <h5 class="card-title"><%= dish.name %></h5>
                <p><strong>Categoria:</strong> <%= dish.category %></p>
                <p><strong>Preço:</strong> €<%= dish.price.toFixed(2) %></p>
                <% if (dish.description) { %>
                  <p><%= dish.description %></p>
                <% } %>
                <p class="text-muted">Informação nutricional: <%= dish.nutriInfo %> kcal</p>

                <div class="mt-auto d-flex justify-content-start gap-2">
                  <a href="/pratos/editar/<%= dish._id %>" class="btn btn-warning btn-sm">Editar Prato</a>
                  <form action="/pratos/remover/<%= dish._id %>" method="POST" onsubmit="return confirm('Remover este prato permanentemente?')">
                    <button class="btn btn-danger btn-sm">Remover Prato</button>
                  </form>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</body>
</html>