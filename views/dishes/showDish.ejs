<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <title><%= dish.name %> - Detalhes</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/styles.css">
</head>
<body>
  <%- include('../partials/navbar') %>
  <div class="container mt-5">
    <div class="card">
      <% if (dish.image) { %>
        <img src="<%= dish.image %>" alt="<%= dish.name %>" class="card-img-top" style="max-height: 400px; object-fit: cover;">
      <% } else { %>
        <img src="/images/sem-imagem.png" alt="Sem imagem" class="card-img-top" style="max-height: 400px; object-fit: cover;">
      <% } %>

      <div class="card-body">
        <h2 class="card-title"><%= dish.name %></h2>
        <p><strong>Categoria:</strong> <%= dish.category %></p>
        <% if (dish.pricePerDose && dish.pricePerDose.length) { %>
          <p><strong>Preços por tipo de dose:</strong></p>
          <ul class="list-group list-group-flush mb-3">
            <% dish.pricePerDose.forEach(p => { %>
              <li class="list-group-item"><strong><%= p.dose %> dose:</strong> €<%= p.price.toFixed(2) %></li>
            <% }) %>
          </ul>
        <% } else { %>
          <p><strong>Preço:</strong> Não disponível</p>
        <% } %>        

        <% if (nutriInfo) { %>
          <p><strong>Informação nutricional:</strong></p>
          <ul class="list-group list-group-flush">
            <li class="list-group-item"><strong>Calorias:</strong> <%= nutriInfo.calories %> kcal</li>
            <li class="list-group-item"><strong>Nutri-score:</strong> <%= nutriInfo.nutriScore %></li>
            <li class="list-group-item"><strong>Alergénios:</strong> <%= nutriInfo.allergens %></li>
        <% } else { %>
          <p><em>Informação nutricional não disponível.</em></p>
        <% } %>        
      </div>
    </div>
  </div>
</body>
</html>