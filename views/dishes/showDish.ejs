<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <title><%= dish.name %> - Detalhes</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/styles.css">
</head>
<body>
  <%- include('../partials/navbar') %>
  <div class="container mt-5">
    <div class="card">
      <% if (dish.image) { %>
        <img src="<%= dish.image %>" alt="<%= dish.name %>" class="card-img-top" style="max-height: 400px; object-fit: cover;">
      <% } else { %>
        <img src="/images/sem-imagem.png" alt="Sem imagem" class="card-img-top" style="max-height: 400px; object-fit: cover;">
      <% } %>

      <div class="card-body">
        <h2 class="card-title"><%= dish.name %></h2>
        <p><strong>Categoria:</strong> <%= dish.category %></p>
        <p><strong>Preço:</strong> €<%= dish.price.toFixed(2) %></p>

        <% if (dish.description) { %>
          <p><strong>Descrição:</strong> <%= dish.description %></p>
        <% } %>

        <% if (nutriInfo) { %>
          <p><strong>Calorias:</strong> <%= nutriInfo.calories || 'Não disponível' %> kcal</p>
          <p><strong>Nutri-Score:</strong> <%= nutriInfo.nutriScore ? nutriInfo.nutriScore.toUpperCase() : 'Não disponível' %></p>
          <p><strong>Alergénios:</strong> <%= nutriInfo.allergens || 'Não especificado' %></p>
        <% } else { %>
          <p><em>Informação nutricional não disponível.</em></p>
        <% } %>        
      </div>
    </div>
  </div>
</body>
</html>