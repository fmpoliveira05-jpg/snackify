<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <title>Pratos do Menu</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <div class="container mt-5">
    <h2><%= menu.title %></h2>
    <div class="row">
      <% dishes.forEach(dish => { %>
        <div class="col-md-4 mb-3">
          <div class="card h-100">
            <div class="card-body d-flex flex-column">
              <h5 class="card-title"><%= dish.name %></h5>
              <p class="card-text"><%= dish.description %></p>
              <% if (dish.pricePerDose && dish.pricePerDose.length) { %>
                <p><strong>Preços por tipo de dose:</strong>
                  <% dish.pricePerDose.forEach(p => { %>
                    <br> <%= p.dose %> dose: €<%= p.price.toFixed(2) %>
                  <% }) %>
                </p>
              <% } else { %>
                <p><strong>Preço:</strong> Não disponível</p>
              <% } %>
              <form action="/carrinho/adicionar" method="POST" class="mt-auto">
                <input type="hidden" name="dishId" value="<%= dish._id %>">
                <input type="number" name="amount" value="1" min="1" class="form-control mb-2" />
                
                <select name="dose" class="form-select mb-2" required>
                  <% if (dish.pricePerDose && dish.pricePerDose.length) { %>
                    <% dish.pricePerDose.forEach(p => { %>
                      <option value="<%= p.dose %>"><%= p.dose.charAt(0).toUpperCase() + p.dose.slice(1) %> dose</option>
                    <% }) %>
                  <% } %>
                </select>
              
                <button type="submit" class="btn btn-success btn-sm">Adicionar ao carrinho</button>
              </form>              
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</body>
</html>