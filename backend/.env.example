# Copie este ficheiro para ".env" e preencha os valores.
# Nunca publique o ficheiro .env: contém segredos.

# --- Servidor ---------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=5000
# Endereço do cliente Angular (CORS, links dos emails e redirecionamentos depois do pagamento)
CLIENT_URL=http://localhost:4200
# Endereço público deste servidor (links do Stripe; em produção tem de ser https://)
SERVER_URL=http://localhost:5000
# Número de proxies de confiança à frente da aplicação (0 = ligação direta; 1 = Nginx/Render/Cloudflare, ...).
# Necessário para o IP real nos limites de pedidos e para o redirecionamento para HTTPS.
TRUST_PROXY=0

# --- Base de dados ----------------------------------------------------------
# Com o docker-compose.yml da raiz (ver o .env.example da raiz):
# MONGODB_URI=mongodb://snackify:<password>@127.0.0.1:27017/snackify?authSource=admin
MONGODB_URI=mongodb://127.0.0.1:27017/snackify

# --- Sessão -----------------------------------------------------------------
# Segredo dos JWT: em produção tem de ter pelo menos 32 caracteres (ex.: openssl rand -base64 48)
JWT_SECRET=troque-isto-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=1h
# Opcionais: emissor e público dos tokens (valores por omissão: snackify-api / snackify-web)
JWT_ISSUER=snackify-api
JWT_AUDIENCE=snackify-web

# --- Email (SMTP) -----------------------------------------------------------
# Usado para confirmar contas e recuperar passwords. Sem SMTP_HOST, fora de produção o link
# é escrito na consola; em produção o envio falha (e é registado sem o link).
SMTP_HOST=
# 587 com STARTTLS (SMTP_SECURE=false) ou 465 com TLS direto (SMTP_SECURE=true)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Snackify <no-reply@exemplo.pt>"

# --- Pagamentos (Stripe) ----------------------------------------------------
# Chave secreta (sk_test_... em testes). Sem ela o pagamento online fica desativado.
STRIPE_SECRET_KEY=
# Segredo do webhook (whsec_...), dado pelo `stripe listen` ou pelo painel do Stripe.
STRIPE_WEBHOOK_SECRET=
# Só em desenvolvimento: "true" permite comprar vales sem pagar (ignorado em produção).
ALLOW_SIMULATED_PAYMENTS=false

# --- Proteção contra bots (Cloudflare Turnstile) ----------------------------
# Deixe vazio para desligar. A chave pública (site key) do Angular fica em
# frontend/src/environments/*.ts; a daqui é usada nos formulários EJS do back-office.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# --- Outros -----------------------------------------------------------------
# Publicar o Swagger (/api-docs) em produção (fora de produção está sempre disponível)
ENABLE_API_DOCS=false
# Limites de pedidos por IP (ligados por omissão; desligados nos testes)
# RATE_LIMIT_ENABLED=true

# --- Seed (npm run seed) ----------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@snackify.local
# Tem de cumprir a regra das passwords (10 a 64 caracteres, maiúscula, minúscula, número e símbolo).
# Vazio = é gerada uma password aleatória (mostrada só fora de produção).
ADMIN_PASSWORD=
