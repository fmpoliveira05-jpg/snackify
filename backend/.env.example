# Copie este ficheiro para ".env" e preencha os valores.

PORT=5000
# Ligação ao MongoDB (local ou Atlas)
MONGODB_URI=mongodb://localhost:27017/snackify
# Segredo usado para assinar os tokens JWT: use um valor longo e aleatório
JWT_SECRET=troque-isto-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=1h
# Endereço do cliente Angular (CORS e redirecionamentos depois do pagamento)
CLIENT_URL=http://localhost:4200
# Endereço público deste servidor (usado nos links do Stripe)
SERVER_URL=http://localhost:5000
# Opcional: chave secreta de TESTE do Stripe (sk_test_...). Sem ela o pagamento online fica desativado.
STRIPE_SECRET_KEY=
