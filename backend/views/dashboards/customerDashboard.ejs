<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/styles.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    
    <div class="container mt-5">
        <h4>Esta é a sua área pessoal.</h4>
        <div id="orderTotalsChart" data-chart='<%= JSON.stringify(orderTotals) %>'></div>
        
        <% if (!isBlocked) { %>
            <button onclick="window.location.href='/cliente/restaurantes'">Encomendar comida</button>
        <% } else { %>
            <div class="alert alert-warning mt-3">
                Está temporariamente impedido(a) de encomendar comida até <strong><%= blockedUntil %></strong>.
            </div>
        <% } %>
    </div>         
    
    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
    <script type="text/javascript" src="/javascripts/drawCharts.js"></script>
</body>
</html>