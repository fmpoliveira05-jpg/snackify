<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <title>Adicionar Prato</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/styles.css">
  <style>
    #imagePreviewContainer {
      display: none;
      margin-bottom: 15px;
      max-width: 300px;
    }
    #imagePreview {
      width: 100%;
      height: auto;
      border-radius: 8px;
      border: 1px solid #ddd;
    }
  </style>
</head>
<body>
  <%- include('../partials/navbar') %>
  
  <div class="container mt-5">
    <h2>Criar novo prato</h2>

    <% if (errors && errors.length > 0) { %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% errors.forEach(error => { %>
            <li><%= error.msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <form action="/restaurante/pratos/novo" method="POST" enctype="multipart/form-data">
      <input 
        name="name" 
        class="form-control mb-2" 
        placeholder="Título do prato" 
        required 
      />

      <textarea 
        name="description" 
        class="form-control mb-2" 
        placeholder="Descrição (opcional)"
      ></textarea>

      <select name="category" class="form-control mb-2" required>
        <option value="">Selecione a categoria</option>
        <% categories.forEach(category => { %>
          <option value="<%= category._id %>"><%= category.name %></option>                       
        <% }) %>
      </select>

      <h6>Selecione o preço por tipo de dose:</h6>

      <div class="input-group mb-2">
        <span class="input-group-text">1/2 Dose</span>
        <input type="hidden" name="dose[]" value="1/2" />
        <input 
          name="price[]" 
          type="number" 
          step="0.01" 
          class="form-control" 
          placeholder="Preço (€)"  
        />
      </div>
      
      <div class="input-group mb-2">
        <span class="input-group-text">1 Dose</span>
        <input type="hidden" name="dose[]" value="1" />
        <input 
          name="price[]" 
          type="number" 
          step="0.01" 
          class="form-control" 
          placeholder="Preço (€)" 
        />
      </div>

      <div id="imagePreviewContainer">
        <img id="imagePreview" src="" alt="Preview da Imagem do Prato" />
      </div>

      <input 
        id="imageInput"
        name="image" 
        type="file" 
        class="form-control mb-2" 
        accept="image/*" 
      />

      <button type="submit" class="btn btn-success">Criar prato</button>
    </form>         
  </div>

  <script src="/javascripts/createImagePreview.js"></script>
</body>
</html>