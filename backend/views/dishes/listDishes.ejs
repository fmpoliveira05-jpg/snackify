<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <title>Cardápio</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/styles.css">
</head>
<body>
  <%- include('../partials/navbar') %>
  
  <div class="container mt-4">
    <h2>Pratos Disponíveis</h2>

    <form action="/cliente/carrinho/adicionar" method="POST">
      <div class="row">
        <% if (dishes.length === 0) { %>
          <p>Não há pratos disponíveis.</p>
        <% } else { %>
          <% dishes.forEach(dish => { %>
            <div class="col-md-4 mb-3">
              <div class="card h-100">
                <% if (dish.image) { %>
                  <img src="<%= dish.image %>" class="card-img-top" alt="Imagem do prato">
                <% } %>
                <div class="card-body">
                  <h5 class="card-title"><%= dish.name %></h5>
                  <p><%= dish.description || 'Sem descrição.' %></p>
                  <label>Dose:</label>
                  <select name="dose_<%= dish._id %>" class="form-control">
                    <% dish.pricePerDose.forEach(p => { %>
                      <option value="<%= p.dose %>"><%= p.dose %> (€<%= p.price.toFixed(2) %>)</option>
                    <% }) %>
                  </select>
                  <input type="hidden" name="dishIds" value="<%= dish._id %>" />
                </div>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
      <button type="submit" class="btn btn-success mt-3">Adicionar ao Carrinho</button>
    </form>
  </div>
</body>
</html>