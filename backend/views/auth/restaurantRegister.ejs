<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Registo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/styles.css">
</head>
<body>
    <%- include('../partials/navbar') %> 
     
    <section class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">Registo do restaurante</div>
                    <div class="card-body">
                        <% if (errors && errors.length > 0) { %>
                            <div class="alert alert-danger">
                              <ul class="mb-0">
                                <% errors.forEach(error => { %>
                                  <li><%= error.msg %></li>
                                <% }) %>
                              </ul>
                            </div>
                          <% } %>                          
                          
                        <form method="POST" action="/auth/registar-restaurante" enctype="multipart/form-data">
                            <input type="hidden" name="userType" value="restaurant">

                            <div class="mb-3">
                                <label class="form-label">Nome</label>
                                <input name="name" type="text" class="form-control" maxlength="50" required value="<%= oldInput?.name || '' %>">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Logotipo (opcional)</label>
                                <input name="logo" type="file" accept="image/*" class="form-control">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Data de fundação</label>
                                <input name="foundedAt" type="date" class="form-control" max="<%= new Date().toISOString().split('T')[0] %>" required value="<%= oldInput?.foundedAt || '' %>">
                            </div>

                            <fieldset class="border p-3 mb-3">
                                <legend class="w-auto px-2">Morada</legend>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Rua</label>
                                        <input name="address[street]" type="text" pattern="^[A-ZÁÂÃÉÊÍÓÔÕÚÇ].*" class="form-control" maxlength="50" required value="<%= oldInput?.address?.street || '' %>">
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <label class="form-label">Número</label>
                                        <input name="address[number]" type="text" pattern="^[0-9]{1,5}([A-Za-z]|[-/][0-9A-Za-z]{1,3})?$" class="form-control" maxlength="10" required value="<%= oldInput?.address?.number || '' %>">
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <label class="form-label">Andar (opcional)</label>
                                        <input name="address[floor]" type="text" pattern="^((R\/C)|(RC)|-?[0-9]{1,2}(º)?([A-Za-z]{1,4})?)$" class="form-control" maxlength="10" value="<%= oldInput?.address?.floor || '' %>">
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Código Postal</label>
                                        <input name="address[zipCode]" type="text" pattern="^\d{4}-\d{3}$" class="form-control" maxlength="8" required value="<%= oldInput?.address?.zipCode || '' %>">
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Localidade</label>
                                        <input name="address[place]" type="text" pattern="^[A-ZÁÂÃÉÊÍÓÔÕÚÇ].*" class="form-control" maxlength="50" required value="<%= oldInput?.address?.place || '' %>">
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Distrito</label>
                                        <input name="address[district]" type="text" pattern="^[A-ZÁÂÃÉÊÍÓÔÕÚÇ].*" class="form-control" maxlength="50" required value="<%= oldInput?.address?.district || '' %>">
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">País</label>
                                    <input name="address[country]" type="text" value="Portugal" class="form-control" maxlength="50" required value="<%= oldInput?.address?.country || '' %>">
                                </div>
                            </fieldset>

                            <div class="mb-3">
                                <label class="form-label">Telefone</label>
                                <input name="phone" type="tel" class="form-control" minlength="9" maxlength="9" required value="<%= oldInput?.phone || '' %>">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">NIF</label>
                                <input name="nif" type="text" class="form-control" minlength="9" maxlength="9" required value="<%= oldInput?.nif || '' %>">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Nome de utilizador</label>
                                <input name="username" type="text" pattern="^\S+$" class="form-control" minlength="5" maxlength="20" required value="<%= oldInput?.username || '' %>">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Email</label>
                                <input name="email" type="email" class="form-control" maxlength="50" required value="<%= oldInput?.email || '' %>">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Palavra-passe</label>
                                <input name="password" type="password" pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[\W_]).+$" class="form-control" minlength="8" maxlength="20">
                            </div>

                            <button type="submit" class="btn btn-success w-100">Registar</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>