<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Registo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/styles.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    
    <section class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">Registo do cliente</div>
                    <div class="card-body">
                        <% if (errors && errors.length > 0) { %>
                            <div class="alert alert-danger">
                              <ul class="mb-0">
                                <% errors.forEach(error => { %>
                                  <li><%= error.msg %></li>
                                <% }) %>
                              </ul>
                            </div>
                          <% } %>                          
                          
                        <form method="POST" action="/auth/registar-cliente" enctype="multipart/form-data">
                            <input type="hidden" name="userType" value="customer">

                            <div class="mb-3">
                                <label class="form-label">Nome</label>
                                <input name="name" type="text"  class="form-control" maxlength="50" required value="<%= oldInput?.name || '' %>">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Foto de perfil (opcional)</label>
                                <input name="profilePicture" type="file" accept="image/*" class="form-control">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Data de nascimento</label>
                                <input name="birthDate" type="date" class="form-control" min="<%= new Date(new Date().setFullYear(new Date().getFullYear() - 120)).toISOString().split('T')[0] %>" max="<%= new Date(new Date().setFullYear(new Date().getFullYear() - 18)).toISOString().split('T')[0] %>" required value="<%= oldInput?.birthDate || '' %>">
                            </div>

                            <fieldset class="border p-3 mb-3">
                                <legend class="w-auto px-2">Morada</legend>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Rua</label>
                                        <input name="address[street]"  type="text" class="form-control" maxlength="50" required value="<%= oldInput?.address?.street || '' %>">
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <label class="form-label">Número</label>
                                        <input name="address[number]" type="text"  class="form-control" maxlength="10" required value="<%= oldInput?.address?.number || '' %>">
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <label class="form-label">Andar (opcional)</label>
                                        <input name="address[floor]" type="text"  class="form-control" maxlength="10" value="<%= oldInput?.address?.floor || '' %>">
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Código Postal</label>
                                        <input name="address[zipCode]" type="text" class="form-control" maxlength="8" required value="<%= oldInput?.address?.zipCode || '' %>">
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Localidade</label>
                                        <input name="address[place]" type="text"  class="form-control" maxlength="50" required value="<%= oldInput?.address?.city || '' %>">
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Distrito</label>
                                        <input name="address[district]" type="text"  class="form-control" maxlength="50" required value="<%= oldInput?.address?.district || '' %>">
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">País</label>
                                    <input name="address[country]" type="text" value="Portugal" class="form-control" maxlength="50" required value="<%= oldInput?.address?.country || '' %>">
                                </div>
                            </fieldset>

                            <div class="mb-3">
                                <label class="form-label">Telemóvel</label>
                                <input name="phone" type="tel" class="form-control" minlength="9" maxlength="9" required value="<%= oldInput?.phone || '' %>">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">NIF (opcional)</label>
                                <input name="nif" type="text" class="form-control" minlength="9" maxlength="9" value="<%= oldInput?.nif || '' %>">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Nome de utilizador</label>
                                <input name="username" type="text"  class="form-control" minlength="5" maxlength="20" required value="<%= oldInput?.username || '' %>">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Email</label>
                                <input name="email" type="email" class="form-control" maxlength="50" required value="<%= oldInput?.email || '' %>">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Palavra-passe</label>
                                <input name="password" type="password"  class="form-control" minlength="8" maxlength="20">
                            </div>

                            <button type="submit" class="btn btn-success w-100">Registar</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>