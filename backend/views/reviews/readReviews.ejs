<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <title>Reviews do Restaurante</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/styles.css">
</head>
<body>
  <%- include('../partials/navbar') %>

  <div class="container mt-5">
    <h2 class="mb-4">Avaliações Recebidas</h2>

    <% if (reviews.length === 0) { %>
      <p>Este restaurante ainda não tem avaliações.</p>
    <% } else { %>
      <div class="row">
        <% reviews.forEach(review => { %>
          <div class="col-md-4 mb-4">
            <div class="card h-100 shadow">
              <% if (review.image) { %>
                <img src="<%= review.image %>" class="card-img-top" alt="Imagem da review">
              <% } else { %>
                <div class="card-img-placeholder">
                  Sem imagem disponível
                </div>
              <% } %>
              <div class="card-body d-flex flex-column">
                <h5 class="card-title"><%= review.title %></h5>
                <p class="card-text"><%= review.description %></p>
                <p class="text-muted mt-auto">Avaliado em: <%= new Date(review.createdAt).toLocaleDateString('pt-PT') %></p>
                <% if (review.userId && review.userId.name) { %>
                  <p class="text-muted">Por: <strong><%= review.userId.name %></strong></p>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</body>
</html>