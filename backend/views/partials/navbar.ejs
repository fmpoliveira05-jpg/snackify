<nav class="navbar navbar-expand-lg navbar-light bg-light">
  <div class="container">
    <a class="navbar-brand" href="<%= user 
      ? (
        user.userType === 'customer' ? '/cliente/dashboard' 
        : user.userType === 'restaurant' ? '/restaurante/dashboard'
        : user.userType === 'admin' ? '/user/perfil'
        : '/'
      )
      : '/'
    %>">Início</a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
      aria-controls="navbarContent" aria-expanded="false" aria-label="Alternar navegação">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarContent">
      <ul class="navbar-nav ms-auto">
        <% if (!user) { %>
          <li class="nav-item">
            <a href="/login" class="nav-link">login</a>
          </li>
        <% } else { %>
          <% if (currentPath !== '/user/perfil') { %>
            <li class="nav-item">
              <a href="/user/perfil" class="nav-link">perfil</a>
            </li>
          <% } %>
          <% if ((user.userType === "customer" || user.userType === "admin") && currentPath !== '/carrinho') { %>
            <li class="nav-item">
              <a href="/cliente/carrinho" class="nav-link">carrinho</a>
            </li>
          <% } %>
        <% } %>          
      </ul>
    </div>
  </div>
</nav>