<nav class="navbar navbar-expand-lg navbar-light bg-light">
  <div class="container">
    <a class="navbar-brand" href="<%= user ? ('/' + (user.userType === 'customer' ? 'cliente' : user.userType === 'restaurant' ? 'restaurante' : user.userType) + '/dashboard') : '/' %>">Início</a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
      aria-controls="navbarContent" aria-expanded="false" aria-label="Alternar navegação">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarContent">
      <ul class="navbar-nav ms-auto">
        <% if (!user) { %>
          <li class="nav-item">
            <form method="GET" action="/auth/login" class="d-inline">
              <button type="submit" class="btn btn-link nav-link">login</button>
            </form>
          </li>
          <% } else { %>
            <% if (currentPath !== '/user/perfil') { %>
              <li class="nav-item">
                <form method="GET" action="/user/perfil" class="d-inline">
                  <button type="submit" class="btn btn-link nav-link">perfil</button>
                </form>
              </li>
            <% } %>
            <% if ((user.userType === "customer" || user.userType === "admin") && currentPath !== '/carrinho') { %>
              <li class="nav-item">
                <form method="GET" action="/cliente/carrinho" class="d-inline">
                  <button type="submit" class="btn btn-link nav-link">carrinho</button>
                </form>
              </li>
            <% } %>
          <% } %>          
      </ul>
    </div>
  </div>
</nav>