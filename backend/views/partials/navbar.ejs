<nav class="navbar navbar-expand-lg navbar-light bg-light">
  <div class="container">
    <a class="navbar-brand" href="<%= user 
      ? (
        user.userType === 'customer' ? clientUrl + '/cliente/dashboard' 
        : user.userType === 'restaurant' ? '/restaurante/dashboard'
        : user.userType === 'admin' ? clientUrl + '/user/perfil'
        : '/'
      )
      : '/'
    %>">Início</a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
      aria-controls="navbarContent" aria-expanded="false" aria-label="Alternar navegação">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarContent">
      <ul class="navbar-nav ms-auto">
        <% if (!user) { %>
          <li class="nav-item">
            <a href="<%= clientUrl %>/login" class="nav-link">login</a>
          </li>
        <% } else { %>
          <% if (currentPath !== '/user/perfil') { %>
            <li class="nav-item">
              <a href="<%= clientUrl %>/user/perfil" class="nav-link">perfil</a>
            </li>
          <% } %>
          <% if ((user.userType === "customer" || user.userType === "admin") && currentPath !== '/carrinho') { %>
            <li class="nav-item">
              <a href="<%= clientUrl %>/cliente/carrinho" class="nav-link">carrinho</a>
            </li>
          <% } %>
        <% } %>          
      </ul>
    </div>
  </div>
</nav>
<% if (user && user.userType === 'restaurant') { %>
  <!-- Aviso de novas encomendas no back-office do restaurante (verifica a cada 20 segundos). -->
  <div id="new-order-toast" class="alert alert-success shadow position-fixed top-0 end-0 m-3 d-none" role="status" style="z-index: 1080;">
    <span id="new-order-text"></span>
    <a href="<%= clientUrl %>/user/perfil" class="alert-link ms-2">ver encomendas</a>
    <button type="button" class="btn-close ms-2" aria-label="Fechar" onclick="this.parentElement.classList.add('d-none')"></button>
  </div>
  <script>
    (function () {
      var known = null;
      function check() {
        fetch('/user/perfil/encomendas', { credentials: 'same-origin', headers: { Accept: 'application/json' } })
          .then(function (res) { return res.ok ? res.json() : []; })
          .then(function (orders) {
            var ids = orders.map(function (o) { return o._id; });
            if (known) {
              var fresh = orders.filter(function (o) { return known.indexOf(o._id) === -1; });
              if (fresh.length) {
                document.getElementById('new-order-text').textContent = fresh.length === 1
                  ? 'Nova encomenda ' + (fresh[0].orderCode || '') + ' recebida.'
                  : fresh.length + ' novas encomendas recebidas.';
                document.getElementById('new-order-toast').classList.remove('d-none');
              }
            }
            known = ids;
          })
          .catch(function () { /* sem ligação: tenta na próxima volta */ });
      }
      check();
      setInterval(check, 20000);
    })();
  </script>
<% } %>
