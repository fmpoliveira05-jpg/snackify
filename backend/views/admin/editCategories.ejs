<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Criar Categoria</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/styles.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    <ul class="list-group mt-4">
        <% if (categorias.length === 0) { %>
            <li class="list-group-item">Nenhuma categoria existente.</li>
        <% } else { %>
            <% categorias.forEach(r => { %>
                <li class="list-group-item"><%= r.name %></li>
            <% }) %>
        <% } %>
    </ul>
    <div class="container mt-5">
        <h1 class="mb-4">Criar Nova Categoria</h1>

        <form action="/admin/criar-categoria" method="POST">
            <div class="mb-3">
                <label for="name" class="form-label">Nome da Categoria</label>
                <input type="text" class="form-control" id="name" name="name" placeholder="Ex: Bebidas" required>
            </div>

            <button type="submit" class="btn btn-primary">Criar Categoria</button>
            <a href="/user/perfil" class="btn btn-secondary">Voltar</a>
        </form>
    </div>
</body>
</html>

    