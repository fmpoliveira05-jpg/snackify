<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <title>Checkout</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/styles.css"/>
</head>
<body>
  <%- include('../partials/navbar') %>

  <div class="container my-5 d-flex justify-content-center">
    <div class="card shadow-lg p-4" style="max-width: 600px; width: 100%;">
      <div class="card-body">
        <h2 class="card-title text-center mb-4">Encomenda Registada</h2>

        <p class="mb-3 text-center">
          O seu código de encomenda é: 
          <strong class="text-primary"><%= order.orderCode %></strong>
        </p>

        <h5>Itens:</h5>
        <ul class="list-group mb-3">
          <% order.dishes.forEach(item => { %>
            <li class="list-group-item">
                <%= item.amount %>x <%= item.dishId.name %> - (<%= item.dose %> dose)
            </li>
          <% }) %>
        </ul>

        <p><strong>Estado da encomenda:</strong> <span class="text-muted"><%= order.state %></span></p>

        <% if (order.state === "pendente") { %>
          <form id="payment-form" method="POST" class="text-center mt-4">
            <input type="hidden" id="orderId" value="<%= order._id %>">
            <input type="hidden" id="orderCode" value="<%= order.orderCode %>">
            <input type="hidden" id="dishes" value='<%- JSON.stringify(order.dishes) %>'>
            <p>Nota: aceda ao seu perfil para efetuar o pagamento.</p>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>