<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <title>Editar Menu</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/styles.css">
</head>
<body>
  <%- include('../partials/navbar') %>
  
  <div class="container mt-5">
    <h2>Editar Menu</h2>

    <% if (errors && errors.length > 0) { %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% errors.forEach(error => { %>
            <li><%= error.msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <form action="/restaurante/menus/editar/<%= menu._id %>?_method=PUT" method="POST">
      <div class="mb-3">
        <label for="title" class="form-label">Título</label>
        <input 
          type="text" 
          class="form-control" 
          id="title" 
          name="title" 
          required
          value="<%= oldInput?.title || menu.title %>"
        >
      </div>

      <div class="mb-3">
        <label for="description" class="form-label">Descrição</label>
        <textarea 
          class="form-control" 
          id="description" 
          name="description" 
          rows="4"
        ><%= oldInput?.description || menu.description %></textarea>
      </div>

      <h4>Adicionar novos pratos</h4>
      <div class="row" id="dishes-grid">
        <% if (availableDishes.length === 0) { %>
          <p class="text-muted">Não há pratos disponíveis no momento.</p>
        <% } else { %>
          <% availableDishes.forEach((dish, index) => { %>
            <div class="col-md-4 mb-3">
              <div class="card dish-card" data-dish-id="<%= dish._id %>">
                <% if (dish.imagePath && dish.image) { %>
                  <img src="/uploads/<%= dish.image %>" class="card-img-top" alt="<%= dish.name %>">
                <% } %>
                <div class="card-body">
                  <h5 class="card-title"><strong>Nome do prato: </strong><%= dish.name %></h5>
                  <% if (!dish.description) { %>
                    <p class="card-text text-muted">Sem descrição.</p>
                  <% } else { %>
                    <p class="card-text"><strong>Descrição do prato: </strong><%= dish.description %></p>
                  <% } %>
                  <p><strong>Categoria:</strong> <%= dish.category?.name %></p>
                </div>
                <input 
                  type="checkbox" 
                  name="availableDishes" 
                  value="<%= dish._id %>" 
                  class="d-none dish-checkbox"
                  <%= (oldInput?.availableDishes?.includes(dish._id.toString()) || menu.dishes?.includes(dish._id.toString())) ? 'checked' : '' %>
                />
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>

      <button type="submit" class="btn btn-primary">Guardar Alterações</button>
      <a href="/restaurante/menus" class="btn btn-secondary ms-2">Cancelar</a>
    </form>
  </div>

  <script src="/javascripts/selectDishes.js"></script>
</body>
</html>